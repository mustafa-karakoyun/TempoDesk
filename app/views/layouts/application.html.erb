<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Kâhya" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kâhya">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="app-header">
      <div class="header-container">
        <a href="<%= root_path %>" class="brand-logo">
          <!-- Kâhya Anahtar / Key İkonu -->
          <svg class="brand-key-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21 2-2 2m-1.5 1.5L16 7l-2-2m-1 3-3 3a5 5 0 1 1-7.07 0 5 5 0 0 1 7.07-7.07l3 3"></path>
            <circle cx="7.5" cy="16.5" r="1.5"></circle>
          </svg>
          <span class="brand-name">Kâhya</span>
        </a>

        <nav class="nav-links">
          <% if authenticated? %>
            <% if current_user&.role_manager? || current_user&.role_cfo? %>
              <a href="<%= manager_expenses_path %>" class="nav-link">Harcamalar</a>
            <% end %>
            <a href="<%= agent_tickets_path %>" class="nav-link">Destek</a>
            <span class="user-badge" style="font-size: 0.85rem; color: var(--slate-600);"><%= current_user&.email_address %></span>
            <%= button_to "Çıkış Yap", session_path, method: :delete, class: "nav-btn-logout" %>
          <% else %>
            <a href="<%= new_session_path %>" class="nav-link nav-link-agent">Giriş Yap</a>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <div class="content-container">
        <% if flash[:notice].present? %>
          <div class="flash-message flash-notice">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span><%= flash[:notice] %></span>
          </div>
        <% end %>

        <% if flash[:alert].present? %>
          <div class="flash-message flash-alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span><%= flash[:alert] %></span>
          </div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="app-footer">
      <div class="footer-container">
        <span>Kâhya — Harcama Denetimi &amp; Destek Masası</span>
      </div>
    </footer>
  </body>
</html>
