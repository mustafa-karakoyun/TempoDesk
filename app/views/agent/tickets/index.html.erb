<% content_for :title, "Temsilci Paneli — TempoDesk" %>

<div class="agent-dashboard">
  <div class="dashboard-header">
    <h1 class="dashboard-title">Destek Masası — Bilet Sırası</h1>
    <p class="dashboard-subtitle">
      Tüm gelen destek talepleri, SLA önceliği ve kalan çözüm süresine göre sıralanmıştır.
    </p>
  </div>

  <!-- Bilet Tablosu -->
  <div class="card ticket-table-card">
    <% if @tickets.any? %>
      <table class="data-table" id="agentTicketsTable">
        <thead>
          <tr>
            <th scope="col" class="col-id">No</th>
            <th scope="col">Bilet / Müşteri</th>
            <th scope="col" class="col-status">Durum</th>
            <th scope="col" class="col-priority">Öncelik</th>
            <th scope="col" class="col-sla">SLA Durumu</th>
            <th scope="col" class="col-date">Hedef Tarih</th>
            <th scope="col" class="col-go"><span class="sr-only">Detay</span></th>
          </tr>
        </thead>
        <tbody>
          <% @tickets.each do |ticket| %>
            <tr class="table-row <%= 'row-breached' if ticket.sla_breached? && !ticket.resolved? %>">
              <td class="cell-id" data-label="No">#<%= ticket.id %></td>
              <td class="cell-ticket">
                <div class="table-ticket-title">
                  <%# Satırın tamamı bu bağlantının ::after katmanıyla tıklanabilir (JavaScript yok). %>
                  <%= link_to ticket.title, agent_ticket_path(ticket), class: "ticket-link" %>
                </div>
                <div class="table-ticket-email"><%= ticket.customer_email %></div>
              </td>
              <td data-label="Durum">
                <span class="badge <%= status_badge_class(ticket.status) %>">
                  <%= status_label(ticket.status) %>
                </span>
              </td>
              <td data-label="Öncelik">
                <span class="badge <%= priority_badge_class(ticket.priority) %>">
                  <%= priority_label(ticket.priority) %>
                </span>
              </td>
              <td data-label="SLA">
                <span class="badge <%= sla_badge_class(ticket) %>">
                  <%= sla_label(ticket) %>
                </span>
              </td>
              <td class="cell-date" data-label="Hedef">
                <time datetime="<%= ticket.due_at.iso8601 %>"><%= ticket.due_at.strftime("%d.%m.%Y %H:%M") %></time>
              </td>
              <td class="cell-go" aria-hidden="true">&rsaquo;</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty-state">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="empty-icon" aria-hidden="true">
          <path d="M22 12h-6l-2 3h-4l-2-3H2"></path>
          <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
        </svg>
        <p class="empty-title">Henüz bilet yok</p>
        <p class="empty-text">Müşteriler yeni bir destek talebi oluşturduğunda biletler burada SLA sırasına göre listelenir.</p>
      </div>
    <% end %>
  </div>
</div>
