<% content_for :title, "#{@expense.merchant} Harcama Detayı ve Denetim İzi | Kâhya" %>

<div>
  <!-- Geri Dönüş Linki -->
  <div style="margin-bottom: 1.5rem;">
    <a href="<%= manager_expenses_path %>" style="color: #64748b; text-decoration: none; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
      <span class="material-symbols-outlined" style="font-size: 18px;">arrow_back</span>
      Harcamalar Listesine Dön
    </a>
  </div>

  <!-- Ana Grid: Sol %60 Harcama & AI, Sağ %40 Dikey Denetim İzi (Audit Log) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; align-items: start;">
    
    <!-- SOL SÜTUN -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <!-- Kart 1: Harcama Bilgileri -->
      <article class="stitch-card">
        <div class="stitch-card-body">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 1rem;">
            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem;">
                <% if @expense.status_approved? %>
                  <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; background: #dcfce7; color: #15803d;">ONAYLANDI</span>
                <% elsif @expense.status_rejected? %>
                  <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; background: #fee2e2; color: #b91c1c;">REDDEDİLDİ</span>
                <% elsif @expense.escalated? %>
                  <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; background: #f3e8ff; color: #6b21a8;">ESKALE EDİLDİ: CFO</span>
                <% else %>
                  <span style="display: inline-block; padding: 0.2rem 0.6rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; background: #fef3c7; color: #b45309;">İNCELEME BEKLİYOR</span>
                <% end %>
                <span class="stitch-category-tag"><%= @expense.category %></span>
              </div>
              <h1 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin: 0 0 0.25rem 0;"><%= @expense.merchant %></h1>
              <div style="font-size: 0.8rem; color: #64748b;">
                Tarih: <%= @expense.spent_on %> • Gönderen Ajan: <strong style="color: #0f172a;"><%= @expense.submitted_by %></strong>
              </div>
            </div>

            <div style="text-align: right;">
              <div style="font-size: 0.7rem; color: #64748b; text-transform: uppercase; font-weight: 600;">Harcama Tutarı</div>
              <div class="stitch-amount-display" style="font-size: 1.75rem;">
                <%= expense_amount_tag(@expense) %>
              </div>
              <div style="font-size: 0.75rem; color: #64748b; margin-top: 2px;">
                Onaycı Rolü: <strong><%= @expense.effective_approver_role.upcase %></strong>
              </div>
            </div>
          </div>

          <!-- Açıklama -->
          <div>
            <div style="font-size: 0.75rem; color: #64748b; text-transform: uppercase; font-weight: 600; margin-bottom: 4px;">
              Harcama Gerekçesi ve Açıklaması
            </div>
            <p style="font-size: 0.95rem; color: #0f172a; background: #eff4ff; padding: 12px 16px; border-radius: 8px; border: 1px solid #e2e8f0; margin: 0; line-height: 1.5;">
              <%= @expense.description %>
            </p>
          </div>

          <!-- Yapay Zekâ Analiz Bölümü -->
          <div class="stitch-ai-panel">
            <div class="stitch-ai-panel-header">
              <div style="display: flex; align-items: center; gap: 0.4rem;">
                <span class="material-symbols-outlined" style="font-size: 22px; color: #d97706;">psychology</span>
                <span style="font-size: 0.9rem; font-weight: 700; color: #0f172a;">AI Denetim ve Risk Değerlendirmesi</span>
              </div>
              <% if @expense.risk_score.present? %>
                <% r = @expense.risk_score %>
                <div style="font-size: 0.8rem; font-weight: 700; color: <%= r >= 70 ? '#ba1a1a' : (r >= 40 ? '#b45309' : '#15803d') %>;">
                  Risk Skoru: <%= r %> / 100
                </div>
              <% end %>
            </div>

            <% if @expense.policy_clause.present? %>
              <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; font-weight: 600; color: #0f172a;">
                <span class="material-symbols-outlined" style="font-size: 16px; color: #64748b;">rule</span>
                <span>Eşleşen Politika: <%= @expense.policy_clause %></span>
              </div>
            <% end %>

            <p class="stitch-ai-text">
              <%= @expense.llm_reason.presence || "Değerlendirme notu bulunmuyor." %>
            </p>
          </div>

          <!-- Karar Aksiyonu -->
          <% if @expense.status_pending_review? && current_user.role.to_s == @expense.effective_approver_role %>
            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 10px; padding: 1.25rem;">
              <h3 style="font-size: 0.95rem; font-weight: 700; color: #0f172a; margin: 0 0 0.5rem 0;">Karar Ver</h3>
              <%= form_with url: decision_manager_expense_path(@expense), method: :patch do |f| %>
                <div style="margin-bottom: 0.75rem;">
                  <label style="display: block; font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 4px;">
                    Karar Notu (Opsiyonel):
                  </label>
                  <%= f.text_area :note, rows: 2, placeholder: "Onay veya ret gerekçesini belirtebilirsiniz...", style: "width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.875rem;" %>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                  <%= f.button name: :decision, value: :approve, class: "stitch-btn-approve" do %>
                    <span class="material-symbols-outlined" style="font-size: 16px;">check</span>
                    <span>Onayla</span>
                  <% end %>
                  <%= f.button name: :decision, value: :reject, class: "stitch-btn-reject" do %>
                    <span class="material-symbols-outlined" style="font-size: 16px;">close</span>
                    <span>Reddet</span>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </article>
    </div>

    <!-- SAĞ SÜTUN: Dikey Denetim İzi (Audit Log) -->
    <div>
      <section class="stitch-card">
        <div class="stitch-card-body">
          <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.75rem;">
            <div>
              <h2 style="font-size: 1.1rem; font-weight: 700; color: #0f172a; margin: 0 0 2px 0;">
                Denetim Kaydı Zaman Çizelgesi
              </h2>
              <p style="font-size: 0.75rem; color: #64748b; margin: 0;">
                Değiştirilemez aktör aksiyonları ve zaman damgaları
              </p>
            </div>
            <span style="font-family: var(--font-mono); font-size: 0.75rem; background: #eff4ff; color: #1e40af; padding: 2px 8px; border-radius: 4px; font-weight: 600;">
              <%= @events.size %> Olay
            </span>
          </div>

          <!-- Dikey Zaman Çizelgesi -->
          <div class="audit-timeline" style="margin-top: 1rem;">
            <% @events.each do |event| %>
              <div class="audit-event-item">
                <div class="audit-event-dot"></div>
                <div class="audit-event-content">
                  <div class="audit-event-header">
                    <span class="audit-actor-name" style="font-size: 0.85rem; display: flex; align-items: center; gap: 4px;">
                      <span class="material-symbols-outlined" style="font-size: 14px;">
                        <%= event.actor == 'llm' ? 'psychology' : (event.actor =~ /agent|bot/i ? 'smart_toy' : 'person') %>
                      </span>
                      <%= event.actor.upcase %>
                    </span>
                    <span class="audit-timestamp"><%= l(event.created_at, format: :short) %></span>
                  </div>
                  <span class="audit-action-badge"><%= event.action %></span>
                  <div class="audit-reason-text"><%= event.reason %></div>
                </div>
              </div>
            <% end %>
          </div>

          <!-- Kriptografik Güvence Rozeti -->
          <div style="border-top: 1px solid #e2e8f0; padding-top: 0.75rem; display: flex; align-items: center; justify-content: space-between; font-size: 0.72rem; color: #64748b;">
            <div style="display: flex; align-items: center; gap: 4px;">
              <span class="material-symbols-outlined" style="font-size: 14px; color: #16a34a;">verified_user</span>
              <span>Kriptografik Denetim Zinciri</span>
            </div>
            <span style="font-family: var(--font-mono);">Ledger #<%= @expense.id %>-KHY</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
