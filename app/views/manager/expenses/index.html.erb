<% is_cfo = current_user.role_cfo? %>
<% content_for :title, (is_cfo ? "CFO Onayı Bekleyenler | Kâhya" : "Harcamalar | Yönetici Paneli | Kâhya") %>

<div class="page-container">
  <!-- Sayfa Başlığı ve Özet Çubuğu -->
  <div class="page-header" style="margin-bottom: var(--space-6);">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: var(--space-4);">
      <div>
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
          <span class="badge" style="background: <%= is_cfo ? '#f3e8ff' : '#eff4ff' %>; color: <%= is_cfo ? '#6b21a8' : '#1e40af' %>; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">
            <%= is_cfo ? "CFO Denetim Masası" : "Yönetim Masası" %>
          </span>
          <span style="font-size: 0.8rem; color: var(--slate-500);">•</span>
          <span style="font-size: 0.8rem; color: var(--slate-500);">Yetkili: <%= current_user.email_address %></span>
        </div>
        <h1 style="font-size: 1.85rem; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; margin: 0 0 8px 0;">
          Karar bekleyen harcamalar
        </h1>
        <p style="font-size: 0.95rem; color: var(--slate-600); margin: 0; max-width: 720px;">
          <% if is_cfo %>
            5.000 TL üzeri yüksek tutarlı ve 24 saat içinde yönetici tarafından karara bağlanmayarak eskale olmuş harcamalar.
          <% else %>
            AI politikası tarafından gri alanda değerlendirilen ve yönetici onayı gerektiren harcamalar. 24 saat içinde karar verilmeyen kalemler CFO onayına devredilir.
          <% end %>
        </p>
      </div>

      <!-- Özet Sayaç -->
      <div style="background: #ffffff; border: 1px solid var(--slate-200); border-radius: var(--radius-md); padding: 10px 18px; box-shadow: var(--shadow-sm); display: flex; align-items: center; gap: 10px;">
        <span style="width: 10px; height: 10px; border-radius: 50%; background: <%= is_cfo ? '#6b21a8' : '#d97706' %>;"></span>
        <span style="font-size: 0.9rem; color: var(--slate-600);">Bekleyen Harcama:</span>
        <strong style="font-size: 1.15rem; color: #0f172a;"><%= @expenses.size %></strong>
      </div>
    </div>
  </div>

  <!-- Harcama Kartları Listesi -->
  <% if @expenses.empty? %>
    <!-- Boş Durum (Empty State) -->
    <div class="card" style="text-align: center; padding: var(--space-8) var(--space-4); background: #ffffff; border: 1px dashed var(--slate-300);">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--slate-100); display: inline-flex; align-items: center; justify-content: center; margin-bottom: var(--space-3); color: var(--slate-500);">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 6px;">Karar Bekleyen Harcama Yok</h2>
      <p style="font-size: 0.95rem; color: var(--slate-600); margin: 0; max-width: 480px; margin: 0 auto;">
        Şu anda onayınızı bekleyen herhangi bir harcama bulunmamaktadır. Yeni harcamalar API üzerinden iletildiğinde burada listelenecektir.
      </p>
    </div>
  <% else %>
    <div class="expense-cards-list">
      <% @expenses.each do |expense| %>
        <article class="expense-card <%= 'expense-card-escalated' if expense.escalated? %>">
          <!-- Üst Durum Çubuğu -->
          <% if expense.escalated? %>
            <div class="card-escalated-bar">
              <span style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                Eskale edildi: CFO
              </span>
              <span style="font-size: 0.8rem; opacity: 0.85;">24 saatlik inceleme süresi aşımı nedeniyle devredildi</span>
            </div>
          <% else %>
            <div class="card-pending-bar">
              <span style="display: inline-flex; align-items: center; gap: 6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <%= escalation_label(expense) %>
              </span>
              <span style="font-size: 0.8rem; opacity: 0.85;">Yönetici Onayı Bekliyor</span>
            </div>
          <% end %>

          <!-- Kart Gövdesi -->
          <div class="expense-card-body">
            <!-- Satıcı ve Tutar Satırı -->
            <div class="expense-card-header">
              <div>
                <h2 class="expense-merchant-title"><%= expense.merchant %></h2>
                <div class="expense-meta">
                  <span class="badge" style="background: var(--slate-100); color: var(--slate-700); font-weight: 600;"><%= expense.category %></span>
                  <span>•</span>
                  <span><%= l(expense.spent_on, format: :long) rescue expense.spent_on.to_s %></span>
                  <span>•</span>
                  <span>Gönderen: <strong><%= expense.submitted_by %></strong></span>
                </div>
              </div>
              <div class="expense-amount-lg">
                <%= expense_amount_tag(expense) %>
              </div>
            </div>

            <!-- Harcama Açıklaması -->
            <div class="expense-description-text">
              <%= expense.description %>
            </div>

            <!-- Yapay Zekâ Denetim Kutusu -->
            <div class="llm-review-card">
              <div class="llm-review-header">
                <span style="display: flex; align-items: center; gap: 6px; color: #0f172a;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                  Yapay Zekâ Denetim Notu
                  <% if expense.policy_clause.present? %>
                    <span style="font-size: 0.8rem; font-weight: 600; color: #64748b;">(<%= expense.policy_clause %>)</span>
                  <% end %>
                </span>

                <% if expense.risk_score.present? %>
                  <% risk_class = expense.risk_score >= 70 ? 'risk-high' : (expense.risk_score >= 30 ? 'risk-medium' : 'risk-low') %>
                  <span class="risk-badge <%= risk_class %>">
                    Risk Skoru: <%= expense.risk_score %>/100
                  </span>
                <% end %>
              </div>
              <p style="margin: 0; color: var(--slate-700); line-height: 1.45;">
                <%= expense.llm_reason.presence || "Değerlendirme notu bulunmuyor." %>
              </p>
            </div>

            <!-- Aksiyon Butonları -->
            <div class="expense-card-actions">
              <div style="display: flex; align-items: center; gap: var(--space-3);">
                <!-- Tek Tık Onay Butonu -->
                <%= button_to decision_manager_expense_path(expense, decision: :approve), method: :patch, class: "btn-approve", form: { style: "display:inline;" } do %>
                  Onayla
                <% end %>

                <!-- Tek Tık Ret Butonu -->
                <%= button_to decision_manager_expense_path(expense, decision: :reject), method: :patch, class: "btn-reject", form: { style: "display:inline;" } do %>
                  Reddet
                <% end %>
              </div>

              <!-- İncele & Denetim İzi Linki -->
              <a href="<%= manager_expense_path(expense) %>" class="btn btn-secondary btn-sm" style="text-decoration: none;">
                İncele &amp; Denetim İzi →
              </a>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</div>
