<% content_for :title, "Yeni Destek Bileti — TempoDesk" %>

<div class="card ticket-form-card">
  <div class="card-header">
    <h1 class="card-title">Yeni Destek Talebi Oluştur</h1>
    <p class="card-subtitle">
      Talebinizi ilettiğinizde biletiniz sıraya alınır ve önceliğine göre SLA süresi başlar.
      Oluşturma sonrasında size özel gizli bir takip bağlantısı verilecektir.
    </p>
  </div>

  <div class="card-body">
    <%= form_with model: @ticket, url: tickets_path, class: "form-stack" do |f| %>
      <% if @ticket.errors.any? %>
        <div class="form-errors">
          <p class="form-errors-title"><%= pluralize(@ticket.errors.count, "hata") %> nedeniyle bilet kaydedilemedi:</p>
          <ul>
            <% @ticket.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :title, "Konu Başlığı", class: "form-label" %>
        <%= f.text_field :title, required: true, autofocus: true, placeholder: "Örn: Sistem raporlama modülüne erişemiyorum", class: "form-input" %>
        <span class="form-hint">Sorununuzu veya talebinizi özetleyen kısa bir başlık yazın.</span>
      </div>

      <div class="form-row-2">
        <div class="form-group">
          <%= f.label :customer_email, "E-posta Adresiniz", class: "form-label" %>
          <%= f.email_field :customer_email, required: true, placeholder: "ornek@sirketiniz.com", class: "form-input" %>
          <span class="form-hint">Destek sürecinde iletişim bu e-posta üzerinden sağlanır.</span>
        </div>

        <div class="form-group">
          <%= f.label :priority, "Öncelik Derecesi", class: "form-label" %>
          <%= f.select :priority,
                [
                  ["Normal (24 saat çözüm SLA)", "normal"],
                  ["Düşük (48 saat çözüm SLA)", "low"],
                  ["Yüksek (8 saat çözüm SLA)", "high"],
                  ["Acil (4 saat çözüm SLA)", "urgent"]
                ],
                {},
                class: "form-select" %>
          <span class="form-hint">SLA çözüm süresi seçilen önceliğe göre otomatik hesaplanır.</span>
        </div>
      </div>

      <div class="form-group">
        <%= f.label :description, "Açıklama ve Detaylar", class: "form-label" %>
        <%= f.text_area :description, rows: 6, required: true, placeholder: "Sorunla nasıl karşılaştınız? Adımları, aldığınız hata mesajlarını detaylıca belirtin...", class: "form-textarea" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Destek Biletini Oluştur", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>
